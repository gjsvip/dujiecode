{
  "name": "dujiecode",
  "private": true,
  "version": "1.0.0",
  "description": "渡劫code（DujieCode）—— Web 版 AI 编程工作台，部署于 Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "deploy": "wrangler deploy",
    "pages": "wrangler pages deploy dist --project-name dujiecode",
    "test": "vitest run",
    "db:init": "wrangler d1 execute dujiecode-db --file=schema.sql --remote"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.78.0"
  }
}
